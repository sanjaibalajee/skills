    { "type": "heading", "level": 2, "text": "Key changes", "id": "key" },
    { "type": "tabs", "tabs": [
      { "label": "limiter.py", "blocks": [
        { "type": "diff", "file": "auth/limiter.py", "lang": "python", "hunks": [
          { "header": "@@ new file @@", "lines": [
            { "type": "add", "text": "def allow(key: str, limit: int = 5, window: int = 60) -> tuple[bool, int]:" },
            { "type": "add", "text": "    # atomic decrement via Lua so concurrent requests can't race the bucket" },
            { "type": "add", "text": "    remaining, retry = redis.eval(BUCKET_LUA, 1, key, limit, window)" },
            { "type": "add", "text": "    return remaining >= 0, retry" }
          ]}
        ], "note": "Atomicity matters here — a non-atomic get/set would let bursts slip through." }
      ]},
      { "label": "routes.py", "blocks": [
        { "type": "diff", "file": "auth/routes.py", "lang": "python", "hunks": [
          { "header": "@@ -41,6 +41,9 @@ def login():", "lines": [
            { "type": "ctx", "text": "@router.post('/login')" },
            { "type": "add", "text": "@rate_limit(limit=5, window=60)" },
            { "type": "ctx", "text": "def login():" },
            { "type": "del", "text": "    return authenticate(request)" },
            { "type": "add", "text": "    return authenticate(request)  # now behind limiter" }
          ]}
        ]}
      ]}
    ]},


    { "type": "heading", "level": 2, "text": "Decisions", "id": "decisions" },
    { "type": "decision", "choice": "Token bucket in Redis (not in-process)", "reversibility": "soft",
      "alternatives": ["in-process LRU counter", "Nginx limit_req", "API-gateway throttle"],
      "rationale": "The API runs multiple workers, so an **in-process** counter would let each worker grant its own quota. Redis is already a dependency, so this adds no new infra. Gateway throttling was rejected because we want per-account limits later, which the gateway can't see." },


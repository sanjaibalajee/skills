      { "label": "New deps", "value": "0", "delta": "reused Redis client", "intent": "good" },
      { "label": "Risk score", "value": "Med", "delta": "1 hot file", "intent": "warn" }
    ]},

    { "type": "heading", "level": 2, "text": "What changed", "id": "what" },
    { "type": "drift", "items": [
      { "planned": "Token-bucket limiter in Redis", "actual": "Implemented as auth/limiter.py with a Lua script for atomic decrement", "status": "as-planned" },
      { "planned": "Apply to /login and /reset", "actual": "Applied to /login, /reset, and also /verify-otp", "status": "changed", "note": "Added /verify-otp after noticing it shares the same abuse surface." },
      { "planned": "Configurable limits via env", "actual": "Hardcoded 5/min in this cut", "status": "skipped", "note": "Deferred to a follow-up; env plumbing was out of scope." },
      { "planned": "", "actual": "Added a /metrics counter for throttled requests", "status": "added", "note": "Unplanned but cheap; helps verify the limiter in staging." }
    ]},

